<UserControl x:Class="HvViewer.App.Events.EventsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ev="clr-namespace:HvViewer.App.Events"
             xmlns:theme="clr-namespace:HvViewer.App.Theme"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <theme:KeyToBrushConverter x:Key="KeyBrush" />
        <theme:EqualsMultiConverter x:Key="Equal" />
        <theme:NotEmptyToVisibilityConverter x:Key="NotEmpty" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="999" Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource TileBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource Equal}">
                            <Binding Path="Key" />
                            <Binding Path="DataContext.PresetKey" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OptionToggle" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="42" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root" Background="Transparent" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSelectedBg}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RowItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource TileBg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSelectedBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="LeftGrid" Grid.Column="0" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="SearchRow" Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Search panel (no scroll bar: everything fits) -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,10">
                <Expander IsExpanded="{Binding IsSearchOpen, Mode=TwoWay}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Search" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="{Binding QueryLine}" FontFamily="{StaticResource FontMono}" FontSize="12" Foreground="{DynamicResource TextMuted}"
                                       Margin="14,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="640" />
                        </StackPanel>
                    </Expander.Header>

                    <StackPanel Margin="0,8,0,0">
                        <!-- Text -->
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0">
                                <ToggleButton Content="Aa" Style="{StaticResource OptionToggle}" IsChecked="{Binding MatchCase}" ToolTip="Match case" />
                                <ToggleButton Content="ab" Style="{StaticResource OptionToggle}" IsChecked="{Binding WholeWord}" ToolTip="Whole word" />
                                <ToggleButton Content=".*" Style="{StaticResource OptionToggle}" IsChecked="{Binding UseRegex}" ToolTip="Regular expression" />
                                <ToggleButton Content="é=e" Style="{StaticResource OptionToggle}" IsChecked="{Binding IgnoreAccents}" ToolTip="Ignore accents" />
                                <Border Style="{StaticResource Pill}" Padding="3" Margin="8,0,0,0" Height="36">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Message" GroupName="Target" Style="{StaticResource SegmentButton}" IsChecked="{Binding IsTargetMessage}" FontSize="12" />
                                        <RadioButton Content="All fields" GroupName="Target" Style="{StaticResource SegmentButton}" IsChecked="{Binding IsTargetAllFields}" FontSize="12" />
                                        <RadioButton Content="Raw XML" GroupName="Target" Style="{StaticResource SegmentButton}" IsChecked="{Binding IsTargetXml}" FontSize="12" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" FontSize="14" MinHeight="36" VerticalContentAlignment="Center"
                                     ToolTip="Find text" AutomationProperties.Name="Find text" KeyDown="OnSearchKeyDown" />
                        </DockPanel>

                        <!-- Date and time -->
                        <DockPanel Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,2,0,0"
                                        ToolTip="yyyy-MM-dd HH:mm:ss, in the time zone chosen in Settings">
                                <TextBlock Text="From" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ev:DateTimeField Text="{Binding FromText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="From date and time" />
                                <TextBlock Text="To" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,6,0" />
                                <ev:DateTimeField Text="{Binding ToText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="To date and time" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Presets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ev:PresetOption}">
                                        <Button Style="{StaticResource ChipButton}" Content="{Binding Label}"
                                                Command="{Binding DataContext.SelectPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Key}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>

                        <!-- More filters -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.8*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.3*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Event IDs" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Ids, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" VerticalScrollBarVisibility="Disabled" FontFamily="{StaticResource FontMono}" ToolTip="Example: 153, 129, -7036 (a leading - leaves an ID out)" AutomationProperties.Name="Event IDs" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Source" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Sources, UpdateSourceTrigger=PropertyChanged}" ToolTip="Example: disk, Service Control Manager" AutomationProperties.Name="Source" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Text="Log category" Style="{StaticResource FieldLabel}" />
                                <ToggleButton x:Name="LogsToggle" HorizontalContentAlignment="Stretch" Checked="OnLogsOpened" Padding="10,8" Cursor="Hand">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="{StaticResource FontIcons}" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Logs.Summary}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </ToggleButton>
                                <Popup IsOpen="{Binding IsChecked, ElementName=LogsToggle, Mode=TwoWay}" PlacementTarget="{Binding ElementName=LogsToggle}"
                                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="14"
                                            Padding="10" Width="420" MaxHeight="520" Margin="0,4,0,0">
                                        <DockPanel DataContext="{Binding Logs}">
                                            <TextBox DockPanel.Dock="Top" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" AutomationProperties.Name="Filter logs" />
                                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                                <Button Content="Select all" Command="{Binding SelectAllCommand}" Padding="12,5" />
                                                <Button Content="Clear all" Command="{Binding ClearAllCommand}" Padding="12,5" Margin="6,0,0,0" />
                                            </StackPanel>
                                            <CheckBox DockPanel.Dock="Top" Content="Analytic &amp; Debug logs" IsChecked="{Binding ShowAnalyticAndDebug}" Margin="2,0,0,8" />
                                            <TreeView ItemsSource="{Binding Roots}" BorderThickness="0" Background="Transparent" MaxHeight="400">
                                                <TreeView.ItemContainerStyle>
                                                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                                        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}" />
                                                    </Style>
                                                </TreeView.ItemContainerStyle>
                                                <TreeView.ItemTemplate>
                                                    <HierarchicalDataTemplate DataType="{x:Type ev:LogNodeVm}" ItemsSource="{Binding Children}">
                                                        <StackPanel Orientation="Horizontal" ToolTip="{Binding Tooltip}">
                                                            <CheckBox IsThreeState="True" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}" MinWidth="0" Padding="6,0,0,0">
                                                                <TextBlock Text="{Binding Label}" />
                                                            </CheckBox>
                                                            <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </HierarchicalDataTemplate>
                                                </TreeView.ItemTemplate>
                                            </TreeView>
                                        </DockPanel>
                                    </Border>
                                </Popup>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Task category" Style="{StaticResource FieldLabel}" TextTrimming="CharacterEllipsis" ToolTip="The Task Windows records on each event (for example SystemStop). The list is filled from the last search results." />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Any" Command="{Binding ClearTaskCommand}" Margin="6,0,0,0" Padding="10,6" />
                                    <ComboBox ItemsSource="{Binding TaskOptions}" SelectedItem="{Binding SelectedTask, Mode=TwoWay}" DisplayMemberPath="Label" MaxDropDownHeight="360" ScrollViewer.VerticalScrollBarVisibility="Visible" AutomationProperties.Name="Task category" />
                                </DockPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Levels and saving -->
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBox Text="{Binding SaveViewName, UpdateSourceTrigger=PropertyChanged}" Width="150" ToolTip="Name for this saved view" AutomationProperties.Name="Saved view name" />
                                <Button Content="Save view" Command="{Binding SaveViewCommand}" Margin="6,0,0,0" Padding="12,7" />
                                <Button Content="Export" Command="{Binding ExportCommand}" Margin="6,0,0,0" Padding="12,7" ToolTip="Save the results as CSV or HTML" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding LevelOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ev:LevelOption}">
                                        <ToggleButton Content="{Binding Label}" IsChecked="{Binding IsSelected}" Style="{StaticResource OptionToggle}" FontFamily="{StaticResource FontUi}" Padding="12,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>

                        <!-- Search and query line -->
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,10,0">
                                <ui:Button Content="Search" Command="{Binding SearchCommand}" Appearance="Primary" Padding="26,7" />
                                <Button Content="Clear filters" Command="{Binding ClearFiltersCommand}" Margin="8,0,0,0" Padding="14,7"
                                        ToolTip="Empties the text, event IDs, source, task category and level boxes" />
                                <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="8,0,0,0" Padding="18,7">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="Copy" Click="OnCopyQuery" Margin="8,0,0,0" Padding="14,7" />
                            <TextBox x:Name="QueryBox" Text="{Binding QueryLine, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}" FontSize="12.5"
                                     ToolTip="Your search as one line (type here and press Enter)" AutomationProperties.Name="Query line" KeyDown="OnQueryKeyDown" />
                        </DockPanel>
                        <TextBlock Text="{Binding QueryLineError}" Foreground="{DynamicResource Critical}" Margin="0,6,0,0"
                                   Visibility="{Binding QueryLineError, Converter={StaticResource NotEmpty}}" />
                    </StackPanel>
                </Expander>
            </Border>

            <!-- Errors -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Errors}" Margin="4,10,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="{DynamicResource Critical}" TextWrapping="Wrap" Margin="0,1" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Status and chart -->
            <StackPanel Grid.Row="2" Margin="4,10,0,6">
                <DockPanel>
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextSecondary}" FontSize="13" VerticalAlignment="Center" />
                    <ProgressBar IsIndeterminate="True" Width="120" Height="3" HorizontalAlignment="Right">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                <Setter Property="Visibility" Value="Hidden" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </DockPanel>
                <TextBlock Text="{Binding SkippedText}" ToolTip="{Binding SkippedDetail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"
                           Visibility="{Binding SkippedText, Converter={StaticResource NotEmpty}}" />
                <ItemsControl ItemsSource="{Binding Histogram}" Height="44" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type ev:HistogramBar}">
                            <Grid Background="Transparent" ToolTip="{Binding Tooltip}" Margin="1,0">
                                <Border Height="{Binding Height}" VerticalAlignment="Bottom" Background="{DynamicResource Accent}" CornerRadius="2" Opacity="0.85" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Results -->
            <Grid Grid.Row="3">
                <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" ItemContainerStyle="{StaticResource RowItem}"
                         Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible"
                         AutomationProperties.Name="Results">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type ev:ResultRow}">
                            <Grid Margin="8,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding TimeText}" FontFamily="{StaticResource FontMono}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="{Binding DateText}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                </StackPanel>
                                <Ellipse Grid.Column="1" Width="10" Height="10" VerticalAlignment="Top" Margin="0,5,0,0" ToolTip="{Binding LevelText}"
                                         Fill="{Binding LevelKey, Converter={StaticResource KeyBrush}}" />
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                    <theme:HighlightTextBlock SourceText="{Binding Message}" Matches="{Binding Matches}" Foreground="{DynamicResource TextSecondary}"
                                                              FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                              Visibility="{Binding Message, Converter={StaticResource NotEmpty}}" />
                                    <TextBlock FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0">
                                        <Run Text="{Binding Source, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding EventId, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <Border Grid.Column="3" Background="{DynamicResource TileBg}" CornerRadius="999" Padding="9,3" VerticalAlignment="Top"
                                        Visibility="{Binding CountText, Converter={StaticResource NotEmpty}}">
                                    <TextBlock Text="{Binding CountText}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty state -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="No events match." FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" />
                    <TextBlock Text="Try a wider time range or fewer filters." Style="{StaticResource Caption}" FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,14" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Last 7 days" Command="{Binding WidenRangeCommand}" Padding="16,8" />
                        <Button Content="Clear filters" Command="{Binding ClearFiltersCommand}" Margin="8,0,0,0" Padding="16,8" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Detail panel (Task 24) -->
        <ContentControl Grid.Column="1" Content="{Binding Detail}" Width="430" Margin="16,0,0,10" Focusable="False">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </Grid>
</UserControl>