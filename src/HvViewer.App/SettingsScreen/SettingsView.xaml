<UserControl x:Class="HvViewer.App.SettingsScreen.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:HvViewer.App.Theme"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <theme:NotEmptyToVisibilityConverter x:Key="NotEmpty" />
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="0,4,10,24" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />

            <TextBlock Text="{Binding SaveMessage}" Foreground="{DynamicResource Critical}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Visibility="{Binding SaveMessage, Converter={StaticResource NotEmpty}}" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Theme" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Auto (follow Windows)" GroupName="Theme" IsChecked="{Binding IsThemeSystem}" Margin="0,0,24,0" />
                        <RadioButton Content="Night" GroupName="Theme" IsChecked="{Binding IsThemeDark}" Margin="0,0,24,0" />
                        <RadioButton Content="Day" GroupName="Theme" IsChecked="{Binding IsThemeLight}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Times" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="This PC's time zone" GroupName="Time" IsChecked="{Binding IsTimeLocal}" Margin="0,0,24,0" />
                        <RadioButton Content="UTC" GroupName="Time" IsChecked="{Binding IsTimeUtc}" />
                    </StackPanel>
                    <TextBlock Text="Used for every time you see, and for the From and To dates you type." Style="{StaticResource Caption}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Default period" Style="{StaticResource SectionTitle}" />
                    <ComboBox ItemsSource="{Binding DefaultRangeOptions}" SelectedValuePath="Key" DisplayMemberPath="Label"
                              SelectedValue="{Binding DefaultRange, Mode=TwoWay}" MinWidth="220" HorizontalAlignment="Left"
                              AutomationProperties.Name="Default period" />
                    <TextBlock Text="The period Home and new searches start with." Style="{StaticResource Caption}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="About" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding ReadOnlyStatement}" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Version" Style="{StaticResource Caption}" Margin="0,3" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Version}" Style="{StaticResource BodyText}" Margin="0,3" />
                        <TextBlock Grid.Row="1" Text="Start-up" Style="{StaticResource Caption}" Margin="0,3" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StartupText}" Style="{StaticResource BodyText}" Margin="0,3" />
                        <TextBlock Grid.Row="2" Text="Rules" Style="{StaticResource Caption}" Margin="0,3" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RulesText}" Style="{StaticResource BodyText}" Margin="0,3" />
                        <TextBlock Grid.Row="3" Text="Settings file" Style="{StaticResource Caption}" Margin="0,3" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SettingsPath}" FontFamily="{StaticResource FontMono}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,3" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding RuleErrors}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{DynamicResource Warning}" TextWrapping="Wrap" FontSize="12.5" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
