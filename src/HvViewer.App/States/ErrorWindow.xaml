<ui:FluentWindow x:Class="HvViewer.App.States.ErrorWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="Hyper-V Viewer - something went wrong"
                  Width="720" Height="560" MinWidth="520" MinHeight="380"
                  WindowStartupLocation="CenterOwner"
                  WindowBackdropType="None"
                  ExtendsContentIntoTitleBar="True"
                  Background="{DynamicResource WindowBg}"
                  FontFamily="{StaticResource FontUi}">
    <Grid Background="{DynamicResource BgGradient}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Hyper-V Viewer" ShowMaximize="False" ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="28,12,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding Headline}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
            <TextBlock Grid.Row="1" Text="{Binding Reassurance}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,4" />

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Margin="0,10,0,14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" FontWeight="SemiBold" Foreground="{DynamicResource Critical}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource FontMono}" FontSize="12"
                             TextWrapping="NoWrap" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextPrimary}"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Error details" />
                </DockPanel>
            </Border>

            <DockPanel Grid.Row="3">
                <Button DockPanel.Dock="Right" x:Name="CloseButton" Content="{Binding CloseText}" Click="OnClose" Padding="22,9" IsDefault="True" />
                <Button DockPanel.Dock="Left" Content="Copy details" Command="{Binding CopyDetailsCommand}" Padding="18,9" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding CopyStatus}" Foreground="{DynamicResource Ok}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </DockPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
