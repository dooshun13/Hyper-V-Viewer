<UserControl x:Class="HvViewer.App.Home.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:home="clr-namespace:HvViewer.App.Home"
             xmlns:ev="clr-namespace:HvViewer.App.Events"
             xmlns:theme="clr-namespace:HvViewer.App.Theme"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <theme:KeyToBrushConverter x:Key="KeyBrush" />
        <theme:EqualsMultiConverter x:Key="Equal" />
        <theme:NotEmptyToVisibilityConverter x:Key="NotEmpty" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="RangeButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="999" Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource TileBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource Equal}">
                            <Binding Path="Key" />
                            <Binding Path="DataContext.RangeKey" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A small block inside a card (processor, memory). -->
        <Style x:Key="HardwareBlock" TargetType="Border" BasedOn="{StaticResource Tile}">
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style x:Key="BlockLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <!--
        The whole page always fits the window with no scroll bar: the content is laid out at 1240 px wide and the
        Viewbox scales it down (or up) to fit whatever size the window is.
    -->
    <Viewbox Stretch="Uniform" StretchDirection="Both" VerticalAlignment="Top" HorizontalAlignment="Left">
        <StackPanel Width="1240" Margin="0,0,0,4">

            <!-- Hero -->
            <DockPanel Margin="0,0,0,10" LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Bottom" Orientation="Horizontal">
                    <Border Style="{StaticResource Pill}" Padding="4" HorizontalAlignment="Right">
                        <ItemsControl ItemsSource="{Binding RangeOptions}" AutomationProperties.Name="Time range">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type home:RangeOption}">
                                    <Button Style="{StaticResource RangeButton}" Content="{Binding Label}"
                                            Command="{Binding DataContext.SelectRangeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Key}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding DateLine}" Style="{StaticResource Caption}" FontSize="13" />
                    <TextBlock Text="{Binding Headline}" FontFamily="{StaticResource FontDisplay}" FontSize="28" TextWrapping="Wrap" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextPrimary}" MaxWidth="820" AutomationProperties.Name="Summary" />
                </StackPanel>
            </DockPanel>

            <!-- Custom range -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCustomRange}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="From" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ev:DateTimeField Text="{Binding CustomFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="From date and time" />
                <TextBlock Text="To" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,8,0" />
                <ev:DateTimeField Text="{Binding CustomTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="To date and time" />
                <Button Content="Apply" Command="{Binding ApplyCustomRangeCommand}" Margin="14,0,0,0" Padding="16,6" />
                <TextBlock Text="{Binding CustomError}" Foreground="{DynamicResource Critical}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>

            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                        <Setter Property="Visibility" Value="Hidden" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Critical}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmpty}}" />

            <!-- Row 1: this PC, severity, health -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.45*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="{Binding SystemTitle}" FontFamily="{StaticResource FontDisplay}" FontSize="18" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SystemSubtitle}" Style="{StaticResource Caption}" FontSize="12.5" Margin="0,1,0,10" TextWrapping="Wrap" />

                        <Grid Margin="0,0,0,10" Visibility="{Binding HasHardware, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource HardwareBlock}" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="PROCESSOR" Style="{StaticResource BlockLabel}" />
                                    <TextBlock Text="{Binding ProcessorName}" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding ProcessorDetail}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource HardwareBlock}" Margin="5,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="MEMORY" Style="{StaticResource BlockLabel}" />
                                    <TextBlock Margin="0,2,0,0" FontSize="13.5" Foreground="{DynamicResource TextPrimary}">
                                        <Run Text="{Binding MemoryTotalText, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="{Binding MemoryUsedText, Mode=OneWay, StringFormat=' · {0}'}" Foreground="{DynamicResource TextMuted}" FontSize="12.5" />
                                    </TextBlock>
                                    <ProgressBar Value="{Binding MemoryPercent, Mode=OneWay}" Maximum="100" Height="5" Margin="0,5,0,3"
                                                 Foreground="{DynamicResource Accent}" AutomationProperties.Name="Memory in use" />
                                    <TextBlock Text="{Binding MemoryDetail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Uptime" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding Uptime}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Last boot" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding LastBoot}" FontWeight="SemiBold" Foreground="{Binding LastBootKey, Converter={StaticResource KeyBrush}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Domain" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding Domain}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Type" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,14" Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="Events by severity" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding SeverityRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type home:SeverityRow}">
                                    <Button Style="{StaticResource FlatButton}" Margin="0,1"
                                            Command="{Binding DataContext.OpenSeverityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="Show these events">
                                        <Grid Margin="4,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="72" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="10" Height="10" Fill="{Binding ColorKey, Converter={StaticResource KeyBrush}}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="10,0" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Delta}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="3" Text="{Binding Value, StringFormat=N0}" FontSize="18" FontWeight="Bold"
                                                       TextAlignment="Right" Foreground="{DynamicResource TextPrimary}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Health checks" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding HealthRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type home:HealthRow}">
                                    <Grid Margin="0,4" ToolTip="{Binding Detail}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource TileBg}">
                                            <TextBlock Text="{Binding Mark}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{Binding MarkKey, Converter={StaticResource KeyBrush}}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="10,0" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Value}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{Binding ValueKey, Converter={StaticResource KeyBrush}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 2: chart and tiles -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.25*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,6,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Error}" VerticalAlignment="Center" />
                                <TextBlock Text="Errors" Style="{StaticResource Caption}" Margin="6,0,12,0" />
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Warning}" VerticalAlignment="Center" />
                                <TextBlock Text="Warnings" Style="{StaticResource Caption}" Margin="6,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="Errors &amp; warnings over time" Style="{StaticResource CardTitle}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Bars}" Height="120">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type home:BarVm}">
                                    <StackPanel VerticalAlignment="Bottom" Margin="2,0" ToolTip="{Binding Tooltip}" Background="Transparent">
                                        <Border Height="{Binding WarningHeight}" Background="{DynamicResource Warning}" CornerRadius="2" Opacity="0.85" Margin="0,0,0,1" />
                                        <Border Height="{Binding ErrorHeight}" Background="{DynamicResource Error}" CornerRadius="2" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding AxisLabels}" Margin="0,6,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,14" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Needs attention" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Tiles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type home:TileVm}">
                                    <Button Style="{StaticResource FlatButton}" Margin="0,0,6,6"
                                            Command="{Binding DataContext.OpenTileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="{Binding Hint}">
                                        <Border Style="{StaticResource Tile}" Padding="10,7">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Ellipse DockPanel.Dock="Right" Width="8" Height="8" VerticalAlignment="Center"
                                                             Fill="{Binding ColorKey, Converter={StaticResource KeyBrush}}" />
                                                    <TextBlock Text="{Binding ValueText}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 3: before the last restart (only after an unexpected restart) and new and unusual -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="16,14" Margin="0,0,6,0">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRestart}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Before the last restart" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding RestartHeading}" Style="{StaticResource Caption}" Margin="0,1,0,6" />
                        <ItemsControl ItemsSource="{Binding RestartRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type home:RestartRow}">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Time}" FontFamily="{StaticResource FontMono}" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                        <Ellipse Grid.Column="1" Width="9" Height="9" Margin="0,0,10,0" Fill="{Binding ColorKey, Converter={StaticResource KeyBrush}}" />
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding Message}" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Source}" FontFamily="{StaticResource FontMono}" FontSize="10.5" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- New and unusual takes the full width when there is no restart card beside it. -->
                <Border Padding="16,14">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <!-- Beside the restart card by default (the column is set here, not on the element, so the trigger can change it). -->
                            <Setter Property="Grid.Column" Value="1" />
                            <Setter Property="Margin" Value="6,0,0,0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRestart}" Value="False">
                                    <Setter Property="Grid.Column" Value="0" />
                                    <Setter Property="Grid.ColumnSpan" Value="2" />
                                    <Setter Property="Margin" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Right" Text="first time in 7 days" Style="{StaticResource Caption}" />
                            <TextBlock Text="New &amp; unusual" Style="{StaticResource CardTitle}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding UnusualRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type home:UnusualRow}">
                                    <Button Style="{StaticResource FlatButton}" Margin="0,1"
                                            Command="{Binding DataContext.OpenUnusualCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="Show these events">
                                        <Grid Margin="4,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{DynamicResource TileBg}" CornerRadius="6" Padding="0,3" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding EventId}" FontFamily="{StaticResource FontMono}" FontSize="12" TextAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Source}" Style="{StaticResource Caption}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding When}" FontFamily="{StaticResource FontMono}" FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{Binding ColorKey, Converter={StaticResource KeyBrush}}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding UnusualMoreText}" Style="{StaticResource Caption}" Margin="4,4,0,0"
                                   Visibility="{Binding UnusualMoreText, Converter={StaticResource NotEmpty}}" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="{Binding SkippedText}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                       Visibility="{Binding SkippedText, Converter={StaticResource NotEmpty}}" />
        </StackPanel>
    </Viewbox>
</UserControl>
