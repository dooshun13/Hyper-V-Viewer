<UserControl x:Class="HvViewer.App.Detail.DetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:det="clr-namespace:HvViewer.App.Detail"
             xmlns:ev="clr-namespace:HvViewer.App.Events"
             xmlns:theme="clr-namespace:HvViewer.App.Theme">
    <UserControl.Resources>
        <theme:KeyToBrushConverter x:Key="KeyBrush" />
        <theme:EqualsMultiConverter x:Key="Equal" />
        <theme:NotEmptyToVisibilityConverter x:Key="NotEmpty" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="999" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource TileBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource Equal}">
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                            <Binding Path="DataContext.SelectedTab" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- A panel that is only visible on its own tab (set Tag to the tab key). -->
        <Style x:Key="TabPanel" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource Equal}">
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                            <Binding Path="DataContext.SelectedTab" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource Card}" Padding="18">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
                <!-- Header -->
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="{StaticResource FontIcons}" ToolTip="Close"
                            AutomationProperties.Name="Close details" Padding="8"
                            Command="{Binding DataContext.CloseDetailCommand, RelativeSource={RelativeSource AncestorType=ev:EventsView}}" />
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="{Binding LevelKey, Converter={StaticResource KeyBrush}}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontFamily="{StaticResource FontMono}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>

                <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}" FontFamily="{StaticResource FontMono}" TextWrapping="Wrap">
                    <Run Text="{Binding TimeText, Mode=OneWay}" /><LineBreak />
                    <Run Text="{Binding LogName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Computer, Mode=OneWay}" /><Run Text=" · record " /><Run Text="{Binding RecordId, Mode=OneWay}" />
                </TextBlock>

                <!-- Tabs -->
                <StackPanel Orientation="Horizontal" Margin="0,14,0,10">
                    <Button Content="Explained" Tag="explained" Style="{StaticResource TabButton}" Command="{Binding SelectTabCommand}" CommandParameter="explained" />
                    <Button Content="Message" Tag="message" Style="{StaticResource TabButton}" Command="{Binding SelectTabCommand}" CommandParameter="message" />
                    <Button Content="XML" Tag="xml" Style="{StaticResource TabButton}" Command="{Binding SelectTabCommand}" CommandParameter="xml" />
                    <Button Content="Raw data" Tag="raw" Style="{StaticResource TabButton}" Command="{Binding SelectTabCommand}" CommandParameter="raw" />
                </StackPanel>

                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <!-- Explained -->
                <StackPanel Tag="explained" Style="{StaticResource TabPanel}">
                    <StackPanel Visibility="{Binding HasRule, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="What it means" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding Meaning}" Style="{StaticResource BodyText}" />
                        <TextBlock Text="Common causes" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding Causes}" Style="{StaticResource BodyText}" />
                        <TextBlock Text="What to do next" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding Next}" Style="{StaticResource BodyText}" />
                        <Button Content="Learn more on Microsoft Learn" Command="{Binding OpenDocsCommand}" Margin="0,14,0,0" Padding="14,7" HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRule}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding NoExplanationText}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding MessageText}" Style="{StaticResource BodyText}" Foreground="{DynamicResource TextSecondary}" Margin="0,10,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Message -->
                <TextBox Tag="message" Style="{StaticResource TabPanel}" Text="{Binding MessageText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         BorderThickness="0" Background="Transparent" FontSize="13" MaxHeight="360" VerticalScrollBarVisibility="Auto"
                         Foreground="{DynamicResource TextPrimary}" />

                <!-- XML -->
                <TextBox Tag="xml" Style="{StaticResource TabPanel}" Text="{Binding Xml, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap"
                         FontFamily="{StaticResource FontMono}" FontSize="12" BorderThickness="0" Background="Transparent" MaxHeight="360" Foreground="{DynamicResource TextPrimary}"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />

                <!-- Raw data -->
                <StackPanel Tag="raw" Style="{StaticResource TabPanel}">
                    <TextBlock Text="{Binding LoadError}" Foreground="{DynamicResource Critical}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding LoadError, Converter={StaticResource NotEmpty}}" />
                    <ItemsControl ItemsSource="{Binding Data}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Key}" Style="{StaticResource Caption}" />
                                    <TextBox Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                             FontFamily="{StaticResource FontMono}" FontSize="12.5" Padding="0" Foreground="{DynamicResource TextPrimary}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Button Content="Copy for ticket" Command="{Binding CopyForTicketCommand}" Margin="0,16,0,0" Padding="14,8" HorizontalAlignment="Left"
                        ToolTip="Copies a short plain-text summary of this event" />

                <!-- Around this event -->
                <Border Height="1" Background="{DynamicResource CardBorder}" Margin="0,18,0,12" />
                <TextBlock Text="Around this event" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Text="Warnings, errors and information in every log, one minute before and after." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,8" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Look in all logs" Command="{Binding LoadAroundCommand}" Padding="14,7" />
                    <Button Content="Cancel" Command="{Binding CancelAroundCommand}" Margin="8,0,0,0" Padding="14,7"
                            Visibility="{Binding IsLoadingAround, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <TextBlock Text="{Binding AroundStatus}" Style="{StaticResource Caption}" Margin="0,8,0,6" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Around}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type det:AroundRow}">
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" /><ColumnDefinition Width="52" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding TimeText}" FontFamily="{StaticResource FontMono}" FontSize="11.5" Foreground="{DynamicResource TextMuted}" />
                                <TextBlock Grid.Column="1" Text="{Binding OffsetText}" FontFamily="{StaticResource FontMono}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" />
                                <Ellipse Grid.Column="2" Width="8" Height="8" Fill="{Binding LevelKey, Converter={StaticResource KeyBrush}}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="{Binding Title}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Event.LogName}" Style="{StaticResource Caption}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
