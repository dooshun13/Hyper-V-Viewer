<UserControl x:Class="HvViewer.App.Saved.SavedViewsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sv="clr-namespace:HvViewer.App.Saved"
             xmlns:theme="clr-namespace:HvViewer.App.Theme">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <theme:NotEmptyToVisibilityConverter x:Key="NotEmpty" />
        <Style x:Key="ShowWhenEditing" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HideWhenEditing" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="0,4,10,24" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Saved views" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Searches you saved from the Events screen. Open one to run it again." Style="{StaticResource BodyText}" Margin="0,6,0,14" />
            <TextBlock Text="{Binding Message}" Foreground="{DynamicResource Critical}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Visibility="{Binding Message, Converter={StaticResource NotEmpty}}" />

            <TextBlock Text="Nothing saved yet. On the Events screen, build a search and press Save view.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type sv:SavedViewItem}">
                        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Style="{StaticResource HideWhenEditing}">
                                        <Button Content="Open" Padding="14,6"
                                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Content="Rename" Padding="12,6" Margin="6,0,0,0"
                                                Command="{Binding DataContext.StartRenameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Content="Delete" Padding="12,6" Margin="6,0,0,0"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Style="{StaticResource ShowWhenEditing}">
                                        <Button Content="Save" Padding="14,6"
                                                Command="{Binding DataContext.CommitRenameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Content="Cancel" Padding="12,6" Margin="6,0,0,0"
                                                Command="{Binding DataContext.CancelRenameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Style="{StaticResource HideWhenEditing}" />
                                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ShowWhenEditing}" MinWidth="260" AutomationProperties.Name="Saved view name" />
                                    <TextBlock Text="{Binding QueryText}" FontFamily="{StaticResource FontMono}" FontSize="12" Foreground="{DynamicResource TextMuted}"
                                               TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
